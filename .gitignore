# Dependencies — restored by `npm install`, never committed
/node_modules

# Mac clutter
.DS_Store

# Debug logs
npm-debug.log*
*.log

# Local caches and scratch
.pnpm-store/
tmp/
.gitscratch/
_to_delete/

# Superseded artwork drafts — kept on disk, not deployed
artwork-archive/

# Business notes — never publish to a public repo
CONTEXT.md

# NOTE: /docs is deliberately NOT ignored. It is the built site that
# GitHub Pages serves, so it has to be committed.
