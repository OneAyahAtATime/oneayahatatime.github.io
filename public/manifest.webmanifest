{
  "id": "./",
  "name": "One Ayah At A Time",
  "short_name": "One Ayah",
  "description": "A warm, illustrated way for families to see and cherish what they are carrying of the Qur'an — one ayah at a time.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#03133e",
  "theme_color": "#03133e",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "related_applications": [
    {
      "platform": "webapp",
      "url": "./manifest.webmanifest",
      "id": "https://oneayahatatime.github.io/"
    }
  ],
  "prefer_related_applications": false
}
